VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Aceita chave publishable moderna OU anon/public legada.
VITE_SUPABASE_PUBLISHABLE_KEY=COLE_SUA_CHAVE_PUBLICA_AQUI
VITE_CONTROL_TECH_URL=https://control-tech-assist.vercel.app/
VITE_VAPID_PUBLIC_KEY=COLE_A_CHAVE_PUBLICA_VAPID_AQUI

# Secrets da Edge Function process-control-tech-request.
# Configure no Supabase do Routine Assist, nunca no frontend publico.
CONTROL_TECH_SUPABASE_URL=https://SEU-PROJETO-CONTROLTECH.supabase.co
CONTROL_TECH_SERVICE_ROLE_KEY=COLE_A_SERVICE_ROLE_DO_CONTROLTECH
CONTROL_TECH_OWNER_USER_ID=COLE_O_ID_DO_USUARIO_DONO_NO_CONTROLTECH

# Secrets da Edge Function send-routine-notifications.
# VAPID_PRIVATE_KEY nunca deve ser adicionada como VITE_*.
VAPID_PUBLIC_KEY=COLE_A_CHAVE_PUBLICA_VAPID_AQUI
VAPID_PRIVATE_KEY=COLE_A_CHAVE_PRIVADA_VAPID_AQUI
VAPID_SUBJECT=mailto:seu-email@empresa.com
